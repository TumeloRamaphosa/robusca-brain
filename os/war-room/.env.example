# War Room — environment template
#
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
#   cp .env.example .env
#
# Every variable the code actually reads is listed here. If a variable is not
# in this file, no code path uses it (verified against `process.env` usage in
# server/index.ts and server/routes.ts).

# ─── Runtime ────────────────────────────────────────────────────────────────
# Port the combined API + client listens on. Defaults to 5000 if unset.
# server/index.ts binds 0.0.0.0 on this port.
PORT=5000

# "production" serves the prebuilt client from dist/public via server/static.ts.
# Anything else (or unset) boots the Vite dev middleware instead.
NODE_ENV=development

# ─── OpenAI — caption generation ────────────────────────────────────────────
# Used by POST /api/generate/caption (model: gpt-4o, streamed as SSE).
# Optional: if unset the server falls back to the literal string "no-key",
# so the route will return a 500 from OpenAI rather than crashing at boot.
OPENAI_API_KEY=

# ─── Higgsfield — image / video generation ──────────────────────────────────
# Used by POST /api/higgsfield/generate. BOTH must be set or the route
# short-circuits with { error: "HIGGSFIELD_KEY_MISSING" }.
# Note: this route polls Higgsfield in-process for up to 90s (image) and a
# further ~120s (video). See DEPLOY.md — this is why the app cannot run on a
# default serverless function.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=

# ─── AgentMail — inbox aggregation ──────────────────────────────────────────
# Used by GET /api/agentmail/messages, which fans out over three hardcoded
# inboxes listed in server/routes.ts. Returns HTTP 503 when unset.
AGENTMAIL_TOKEN=

# ─── Not required ───────────────────────────────────────────────────────────
# package.json still declares @supabase/supabase-js, passport, passport-local,
# express-session, memorystore and ws, but no source file imports any of them.
# They are scaffold leftovers. There is therefore NO login on this app and no
# SUPABASE_* / SESSION_SECRET variable to set. Do not expose this app on a
# public hostname until auth exists — see DEPLOY.md.
