# Studex OS — copy to .env. Never commit .env.

# Postgres with the vector extension. Holds the control plane schema plus one
# ghost_<slug> schema per tenant.
DATABASE_URL=postgres://user:pass@host:5432/studex

# Daytona — sandboxes, volumes, snapshots, secrets.
DAYTONA_API_KEY=
# eu-central is the closest available region and is GDPR-aligned for EU coffee
# buyers. There is no African region; do not promise in-country residency for
# execution. Client records live in the control plane, which you site separately.
DAYTONA_REGION=eu-central

# Fly.io — one OpenClaw Gateway per tenant.
FLY_API_TOKEN=
FLY_ORG=studex

# Default for new tenants. Must be a valid IANA zone — provisioning rejects
# anything else, because OpenClaw silently defaults to UTC.
DEFAULT_TIMEZONE=Africa/Johannesburg
